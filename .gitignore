node_modules/
.venv/
.env
# Worker のローカルD1状態と secret。secretはwrangler側へ入れる
.wrangler/
.dev.vars
__pycache__/
.pytest_cache/
npm-debug.log*
*.log
*.sqlite*

# LLM 実験。コーパスと重みは git に入れない (数十MB〜)
.venv-llm/
corpus/
scripts/llm/out/

# HF に上げる用の書き出し (重みは git に入れない)
dist/

# evex-1 の tokenizer 一式 (チェックポイントと対なので凍結)
corpus-v1/

# 学習データ。実 ID と発言本文が入るのでコミットしない (corpus/ と同じ扱い)。
# **世代付きも塞ぐ** — sft-v3/ sft-v4/ corpus-v3/ が漏れていて、追跡されない前提で
# 実発言と Discord の user ID を置いていた
sft/
/sft-v*/
/corpus-v*/

# 追加学習に混ぜる公開データ (llm-jp/oasst1-21k-ja など)。HF から落とせるので持たない
/mix/

# 事前学習に使う公開データ (なりきり掲示板 317MB / JESC)。HF から落とせるので持たない。
# 変換後の corpus-v* も別途塞いである
/external/

# 推論サーバーに置く重みと対応表 (mimic-ft / ft1 は 2.3GB)。
# **先頭の / を外すと `src/mimic/` まで無視される** — 実際にやって
# ソースが git add できなくなった。ここは全部リポジトリ直下に固定する
/mimic/
/mimic-ft/
/ft1/
/ft2/
/evex4/
