{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sakana-laws",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "send_metrics": false,
  "observability": { "enabled": true },
  // 法令集は公開ページなのでworkers.devで出す。版ごとのpreview URLは増やさない。
  "workers_dev": true,
  "preview_urls": false,
  // 記憶の本 (/wiki) は Discord ログインで、このサーバーのメンバーだけに見せる (既定は閉じている)。
  //   MEMORY_GUILD_ID                     見せるサーバー
  //   MEMORY_ACCESS                       'members' (既定) | 'public'
  //   secret: DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET / SESSION_SECRET
  //   Discord の開発者ポータルの OAuth2 > Redirects に https://<このサイト>/auth/callback を登録する
  "vars": { "MEMORY_GUILD_ID": "1255359848644608035", "MEMORY_ACCESS": "members" },
  "d1_databases": [
    {
      "binding": "LAWS",
      "database_name": "sakana-laws",
      "database_id": "a7a062b4-750f-46bd-b1b6-1663e6537efe",
      "migrations_dir": "migrations"
    }
  ]
}
