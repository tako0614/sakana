{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sakana-laws",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "send_metrics": false,
  "observability": { "enabled": true },
  // 法令集は公開ページ。正式なドメインは sakana.takos.jp (takos.jp の zone に Worker のカスタムドメインとして付く。DNS と証明書は Cloudflare が作る)。
  // workers.dev も残す: bot が法令・記憶を押し込む先 (GOVERNANCE_LAW_API_URL) と、これまでの URL をそのまま使えるように。版ごとのpreview URLは増やさない。
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "sakana.takos.jp", "custom_domain": true }],
  // 記憶 (/<サーバーID>/wiki) は、Discord でログインした、そのサーバーのメンバーだけが読める (検索エンジンには noindex)。
  //   MEMORY_GUILD_IDS   見せるサーバー (カンマ区切り。ここに無いサーバーの URL は 404)
  //   MEMORY_ACCESS      'members' (既定。ログイン必須) | 'public' (誰でも)。2026-10-18 に 'members' にした。
  //                      サーバーごとの off / members / public は D1 (memory_site_access) が先で、これは設定が無いサーバーの既定 (worker/README.md)
  //   MEMORY_SITE_ORIGIN ログインの入口。Discord の OAuth2 > Redirects にここの /auth/callback を登録する
  //   DISCORD_CLIENT_ID  ログイン用の Discord アプリの ID (公開してよい。bot のアプリと同じでなくてよい)
  //   secret: DISCORD_CLIENT_SECRET (Discord アプリの Client Secret) / SESSION_SECRET (cookie の署名の鍵。ランダムな文字列)
  "vars": {
    "MEMORY_GUILD_IDS": "1255359848644608035",
    "MEMORY_ACCESS": "members",
    "MEMORY_SITE_ORIGIN": "https://sakana.takos.jp",
    "DISCORD_CLIENT_ID": "1561330177924141127"
  },
  "d1_databases": [
    {
      "binding": "LAWS",
      "database_name": "sakana-laws",
      "database_id": "a7a062b4-750f-46bd-b1b6-1663e6537efe",
      "migrations_dir": "migrations"
    }
  ]
}
