{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sakana-laws",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "send_metrics": false,
  "observability": { "enabled": true },
  // 法令集は公開ページ。正式なドメインは sakana.takos.jp (takos.jp の zone に Worker のカスタムドメインとして付く。DNS と証明書は Cloudflare が作る)。
  // workers.dev も残す: bot が法令・記憶を押し込む先 (GOVERNANCE_LAW_API_URL) と、これまでの URL をそのまま使えるように。版ごとのpreview URLは増やさない。
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "sakana.takos.jp", "custom_domain": true }],
  // 記憶 (/<サーバーID>/wiki) は誰でも読める公開サイト (ログインは無い。検索エンジンには noindex)。
  //   MEMORY_GUILD_IDS   見せるサーバー (カンマ区切り。ここに無いサーバーの URL は 404)
  "vars": { "MEMORY_GUILD_IDS": "1255359848644608035" },
  "d1_databases": [
    {
      "binding": "LAWS",
      "database_name": "sakana-laws",
      "database_id": "a7a062b4-750f-46bd-b1b6-1663e6537efe",
      "migrations_dir": "migrations"
    }
  ]
}
