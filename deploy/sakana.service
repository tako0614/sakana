[Unit]
Description=Sakana Discord bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/root/sakana
ExecStart=/usr/bin/node --import tsx src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sakana

[Install]
WantedBy=multi-user.target
