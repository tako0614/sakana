[Unit]
Description=Sakana mimic evex-5.1 (25.8M / PLE + Muon / コーパス v11)
# evex-1 (8767) / evex-2 (8765) / evex-3 (8770) / evex-3.5 (8771) /
# evex-4 (8772) / evex-4.1 (8773) と並走させる。**置き換えない。**
#
# **語彙が別物。**corpus-v11 は `<|hi|>` を足したぶんトークン番号がずれている
# ので、mimic-v4/ や mimic-v41/ の tok.model と取り違えると全部バイト分解されて
# 出力が崩壊する (例外は出ない)。
#
# **25.8M で重みが 98MB**ある (PLE のぶん)。他の evex 系より大きいので
# MemoryMax を上げてある。ただし**行列積は 18.88M 世代とほぼ同じ**なので、
# 応答の速さは変わらない。
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/sakana
# ファイル名は pack.mjs が置く形に合わせる (ckpt.pt / tok.model / speakers.json)。
#   LLM_CORPUS_DIR=corpus-v11 node scripts/llm/pack.mjs <ckpt-eN.pt> dist/mimic-v51
ExecStart=/root/sakana/.venv-llm/bin/python -u src/mimic/server.py \
  --ckpt /root/sakana/mimic-v51/ckpt.pt \
  --corpus /root/sakana/mimic-v51 \
  --port 8775 \
  --threads 3

Restart=on-failure
RestartSec=5

# 18.9M の重み (76MB) + torch のランタイム。evex-1/2/3 と ft 系が並ぶので控えめに。
# 足りずに OOM で落ちるようなら 1800M まで上げる
MemoryMax=1800M
CPUWeight=30
Nice=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
