[Unit]
Description=Sakana mimic evex-3.5 (18.9M / 語彙12288 / 二段学習)
# evex-1 (8767) / evex-2 (8765) / evex-3 (8770) と並走させる。
#
# **--corpus は mimic-v35/ を指す。**evex-3 の mimic-v3/ と混ぜてはいけない —
# 語彙が 4096 と 12288 で別物なので、取り違えると全部バイト分解されて
# 出力が崩壊する (例外は出ない)。
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/sakana
# ファイル名は pack.mjs が置く形に合わせる (ckpt.pt / tok.model / speakers.json)。
#   LLM_CORPUS_DIR=corpus-v5 node scripts/llm/pack.mjs <ckpt-eN.pt> dist/mimic-v35
ExecStart=/root/sakana/.venv-llm/bin/python -u src/mimic/server.py \
  --ckpt /root/sakana/mimic-v35/ckpt.pt \
  --corpus /root/sakana/mimic-v35 \
  --port 8771 \
  --threads 3

Restart=on-failure
RestartSec=5

# 18.9M の重み (76MB) + torch のランタイム。evex-1/2/3 と ft 系が並ぶので控えめに。
# 足りずに OOM で落ちるようなら 1800M まで上げる
MemoryMax=1500M
CPUWeight=30
Nice=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
