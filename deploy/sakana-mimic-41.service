[Unit]
Description=Sakana mimic evex-4.1 (18.9M / 語彙12288 / コーパス v8)
# evex-1 (8767) / evex-2 (8765) / evex-3 (8770) / evex-3.5 (8771) /
# evex-4 (8772) と並走させる。**置き換えない。**
#
# 数字の上では evex-4 の方が良い (役の噛み合い 53.3% 対 36.7%)。ただし
# 噛み合いは「質問の語を拾ったか」しか見ないので、**話が逸れるけど面白い返し**は
# 低く出る。4.1 は train-val の差が大きく (2.5067/5.2162 対 2.4911/5.0172)、
# 逐語コピーは 0% のまま学習分布に寄っている。読み比べて決めるために並べる。
#
# **--corpus は mimic-v41/ を指す。**evex-3 の mimic-v3/ と混ぜてはいけない —
# 語彙が 4096 と 12288 で別物なので、取り違えると全部バイト分解されて
# 出力が崩壊する (例外は出ない)。evex-3.5 の mimic-v35/ とは語彙の大きさは
# 同じだが**中身が違う** (コーパス v7 で作り直した) ので、これも混ぜない。
#
# **mimic-v41/ に channels.json を置くこと。**evex-4 は窓の先頭に
# `<|c0|>..<|c15|>` を置く形で学習している。無いと全部 `<|cx|>` に落ちて、
# 話題の手がかりが推論だけ死ぬ (例外は出ない)。pack.mjs が入れる。
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/sakana
# ファイル名は pack.mjs が置く形に合わせる (ckpt.pt / tok.model / speakers.json)。
#   LLM_CORPUS_DIR=corpus-v8 node scripts/llm/pack.mjs <ckpt-eN.pt> dist/mimic-v41
ExecStart=/root/sakana/.venv-llm/bin/python -u src/mimic/server.py \
  --ckpt /root/sakana/mimic-v41/ckpt.pt \
  --corpus /root/sakana/mimic-v41 \
  --port 8773 \
  --threads 3

Restart=on-failure
RestartSec=5

# 18.9M の重み (76MB) + torch のランタイム。evex-1/2/3 と ft 系が並ぶので控えめに。
# 足りずに OOM で落ちるようなら 1800M まで上げる
MemoryMax=1500M
CPUWeight=30
Nice=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
