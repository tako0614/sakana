[Unit]
Description=Sakana memory tree builder (one pass; resumes from its cursors)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# .env (OPENROUTER_API_KEY, MEMORY_TREE_GUILD, MEMORY_TREE_MODELS ...) は dotenv が作業ディレクトリから読む。
# リリースを切り替えるときは sakana.service と同じく drop-in (90-release.conf) で ExecStart を差し替える。
WorkingDirectory=/root/sakana
# 溜まっている分は読み切るまで続ける (初回の全履歴は十数時間)。読み終えたら timer が1時間おきに新着を読む
# 失敗した区切りは起動のたびに読み直す (1区切り3回まで)
# TypeScript なので tsx を通す (sakana.service と同じ)
ExecStart=/usr/bin/node --import tsx scripts/memory-tree.ts run --retry-failed
TimeoutStartSec=infinity
Nice=10
# idle クラスは bot の取り込みに負けて止まる (実測) ので best-effort の最低優先度
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sakana-memory
