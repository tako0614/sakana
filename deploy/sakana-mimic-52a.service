[Unit]
Description=Sakana mimic evex-5.2-a (25.8M / PLE + QK-norm だけ (AdamW + cosine) / コーパス v12)
# **evex-5.2-a と 5.2-b は対照実験。**同じコーパス (v12) で、違うのは
# Muon / WSD / 文書内マスク の有無だけ。
#
#   a (8776)  PLE + QK-norm だけ。学習は AdamW + cosine で evex-4.1 と同じ
#   b (8777)  a に Muon + WSD + 文書内マスク を足したもの
#
# evex-5 / 5.1 が 4.1 に負けた原因が「一度に足した技術群」なのかを見るために
# 並べてある。**読み比べて決める** — 指標はこれまで評価と一致していない。
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/sakana
# ファイル名は pack.mjs が置く形に合わせる (ckpt.pt / tok.model / speakers.json)。
#   LLM_CORPUS_DIR=corpus-v12 node scripts/llm/pack.mjs <ckpt-eN.pt> dist/mimic-v52a
ExecStart=/root/sakana/.venv-llm/bin/python -u src/mimic/server.py \
  --ckpt /root/sakana/mimic-v52a/ckpt.pt \
  --corpus /root/sakana/mimic-v52a \
  --port 8776 \
  --threads 3

Restart=on-failure
RestartSec=5

# 18.9M の重み (76MB) + torch のランタイム。evex-1/2/3 と ft 系が並ぶので控えめに。
# 足りずに OOM で落ちるようなら 1800M まで上げる
MemoryMax=1800M
CPUWeight=30
Nice=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
