DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: set this while developing so slash commands update instantly in one server.
DISCORD_GUILD_ID=your_test_server_id_here

# Optional: normal message trigger.
OSS_TARGET_USERNAME=
OSS_TRIGGER_TEXT=
OSS_RESPONSE_TEXT=

# Optional: message archive + search index (/index, /search).
ARCHIVE_DB_PATH=archive.sqlite
ARCHIVE_TZ_OFFSET_HOURS=9
ARCHIVE_FETCH_DELAY_MS=150
ARCHIVE_REGEX_BUDGET=300000

# Optional: AI agent. Set DEEPSEEK_API_KEY to enable it (mention the bot to use it).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# low / high / max のうち真ん中。thinking を切るなら AGENT_THINKING=false
AGENT_REASONING_EFFORT=high
AGENT_THINKING=true

# 呼び出し制限 (既定: 1人 30回/時 ・ 全体 500回/日)
AGENT_USER_LIMIT=30
AGENT_USER_WINDOW_MS=3600000
AGENT_GLOBAL_LIMIT=500
AGENT_GLOBAL_WINDOW_MS=86400000
AGENT_MAX_CONCURRENT=3
AGENT_EXEMPT_USERS=

# トークン節約のつまみ
AGENT_MAX_ROUNDS=10
AGENT_MAX_TOOL_CHARS=24000
AGENT_MESSAGE_CHARS=300
AGENT_PRELOAD_MESSAGES=30
AGENT_MAX_OUTPUT_TOKENS=4000
AGENT_TIMEOUT_MS=150000
# 「-# thinking (10s)」の更新間隔。Discord の編集制限に当たるようなら 2000 に上げる
AGENT_PROGRESS_INTERVAL_MS=1000

# 外付け Chrome (deckide が 9222 に常駐させている共有ブラウザに相乗りする)
AGENT_BROWSER=true
AGENT_BROWSER_CDP_HOST=127.0.0.1
AGENT_BROWSER_CDP_PORT=9222
AGENT_BROWSER_TEXT_CHARS=4000
AGENT_BROWSER_TIMEOUT_MS=30000
# クリック・入力・eval・生 CDP を誰に許すか。既定は「サーバー管理」権限持ちと下のIDのみ。
AGENT_BROWSER_FULL_FOR_ALL=false
AGENT_BROWSER_TRUSTED_USERS=
AGENT_BROWSER_ALLOW_LOCAL=false

# Optional: reply "きもち" to analyze the referenced message's emotions.
EMOTION_TRIGGER_TEXT=きもち
EMOTION_PYTHON_BIN=python3
EMOTION_MODEL_NAME=neuralnaut/deberta-wrime-emotions
EMOTION_MAX_LENGTH=128
EMOTION_ANALYSIS_TIMEOUT_MS=180000
