                "maximumVisits": 3,
                "phase": "deliberation"
              },
              "on": {
                "acquitted": "final",
                "execution": "execution",
                "appeal_window": "appeal_window",
                "defense": "defense",
                "exhausted": "final",
                "approval": "approval"
              }
            },
            "appeal_window": {
              "handler": "appeal_window",
              "duration": "1d",
              "config": {
                "phase": "appeal_window"
              },
              "on": {
                "appeal": "appeal",
                "execution": "execution",
                "approval": "approval"
              }
            },
            "appeal": {
              "handler": "judicial_panel",
              "duration": null,
              "config": {
                "institution": "courtInstitution",
                "phase": "appeal"
              },
              "on": {
                "overturned": "final",
                "execution": "execution",
                "approval": "approval"
              }
            },
            "execution": {
              "handler": "sanction_execution",
              "duration": null,
              "config": {
                "phase": "execution"
              },
              "on": {
                "final": "final",
                "contest_window": "contest_window",
                "unenforceable": "final"
              }
            },
            "final": {
              "handler": "terminal",
              "duration": null,
              "config": {
                "phase": "final"
              },
              "on": {}
            },
            "police_review": {
              "handler": "police_review",
              "duration": null,
              "config": {
                "institution": "policeInstitution",
                "phase": "police_review"
              },
              "on": {
                "acquitted": "final",
                "execution": "execution",
                "filing": "filing",
                "approval": "approval"
              }
            },
            "contest_window": {
              "handler": "contest_window",
              "duration": "1d",
              "config": {
                "phase": "contest_window"
              },
              "on": {
                "filing": "filing",
                "final": "final"
              }
            },
            "filing": {
              "handler": "case_filing",
              "duration": null,
              "config": {
                "phase": "filing"
              },
              "on": {
