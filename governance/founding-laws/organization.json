                "revision": "draft",
                "rejected": "rejected"
              }
            },
            "review": {
              "handler": "constitutional_panel",
              "duration": null,
              "config": {
                "institution": "constitutionalInstitution"
              },
              "on": {
                "constitutional": "vote",
                "revision": "draft"
              }
            },
            "enact": {
              "handler": "law_enactment",
              "duration": null,
              "config": {},
              "on": {
                "enacted": "enacted",
                "stale": "rejected"
              }
