          "mandate": "AIが起草、採択、憲法審査および改稿を行い、法律で定める公開投票を経て成立させる。",
          "initial": "agenda",
          "states": {
            "agenda": {
              "handler": "parliament_agenda",
              "duration": null,
              "config": {},
              "on": {
                "adopted": "draft",
                "rejected": "rejected"
              }
            },
            "draft": {
              "handler": "legislation_draft",
              "duration": null,
              "config": {
                "maximumVisits": 3
              },
              "on": {
                "drafted": "adoption",
                "exhausted": "rejected"
              }
            },
            "adoption": {
              "handler": "ai_ratification",
              "duration": null,
              "config": {
                "institution": "adoptionInstitution"
              },
              "on": {
