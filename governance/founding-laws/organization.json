              "duration": null,
              "config": {},
              "on": {}
            },
            "vote": {
              "handler": "public_vote",
              "duration": "12h",
              "config": {},
              "on": {
                "passed": "enact",
                "rejected": "rejected"
              }
            }
          },
          "config": {}
        }
