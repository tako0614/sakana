      {
        "kind": "procedure",
        "key": "criminalCaseProcedure",
        "article": "A3",
        "value": {
          "name": "刑事手続",
          "mandate": "証拠、適正手続、比例性、救済の機会を保障し、AIが判断と執行を遂行する。",
          "initial": "police_review",
          "config": {
            "reopen": {
              "filing": "filing"
            },
            "interruptions": {
              "dismissed": "final",
              "overturned": "final",
              "unenforceable": "final",
              "final": "final"
            }
          },
          "states": {
            "defense": {
              "handler": "defense_window",
              "duration": "1d",
              "config": {
                "phase": "defense"
              },
              "on": {
